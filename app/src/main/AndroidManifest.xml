<manifest package="app.oneclick.vpn" xmlns:android="http://schemas.android.com/apk/res/android">
  <application android:label="OneClick VPN" android:theme="@style/Theme.OneClick">
    <activity android:name=".ui.MainActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <service android:name=".vpn.OneClickVpnService" android:permission="android.permission.BIND_VPN_SERVICE" android:exported="true">
      <intent-filter><action android:name="android.net.VpnService"/></intent-filter>
    </service>
    <service android:name=".ui.OneClickVpnTileService" android:label="OneClick VPN" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
      <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
    </service>
  </application>
</manifest>
